# See https://help.github.com/articles/ignoring-files/

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Angular CLI cache and tooling
.angular/

# Sass cache (if you use sass outside the CLI)
.sass-cache/

# TypeScript incremental build info (if generated at repo root)
*.tsbuildinfo

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets (keep a tracked example if you use env files)
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Testing / coverage
/coverage
*.lcov
.nyc_output


.claude/ 

# Logs and misc
*.log
testem.log
/libpeerconnection.log
/connect.lock
/typings

# System files
.DS_Store
Thumbs.db

# Merge / editor backups
*.orig
*.rej

# Optional: local scratch / notes (remove if you want these tracked)
*.local
